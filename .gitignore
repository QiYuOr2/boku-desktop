# mygo dev 的 dev 版本与 mygo build 的打包结果
/build/
/.mygo/

# 编译产物
*.syso
*.test
*.exe

# 本地数据库（真实数据库在 mygo.App.Path(mygo.PathUserData) 之下，
# 测试用 :memory: 或临时目录）
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# 环境变量
.env.local
.env.*.local
!.env.example

# 编辑器
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
._*
Thumbs.db
Desktop.ini
