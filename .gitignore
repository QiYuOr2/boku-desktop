# mygo dev 的 dev 版本与 mygo build 的打包结果
/build/
/.mygo/

# 编译产物
*.syso
*.test
*.exe

# 测试夹具里的快捷方式：开机自启动的 .lnk 读取测试要用一份 Windows 真正
# 写出来的文件。开发机上常见的全局 gitignore 里有 *.lnk（防止误提交自己
# 桌面上的快捷方式），这里把测试目录下的那一份显式放回来。
!/internal/platform/autostart/testdata/*.lnk

# 本地数据库（真实数据库在 mygo.App.Path(mygo.PathUserData) 之下，
# 测试用 :memory: 或临时目录）
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# 环境变量
.env.local
.env.*.local
!.env.example

# 编辑器
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
._*
Thumbs.db
Desktop.ini
